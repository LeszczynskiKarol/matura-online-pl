---
interface Props {
  src: string;
  title?: string;
  transcript?: string;
}

const { src, title = "Nagranie do zadań słuchania", transcript } = Astro.props;
---

<div class="audio-player" data-audio-player>
  <div class="audio-player__head">
    <div class="audio-player__title">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 18V5l12-2v13"></path>
        <circle cx="6" cy="18" r="3"></circle>
        <circle cx="18" cy="16" r="3"></circle>
      </svg>
      <span>{title}</span>
    </div>
    <div class="audio-player__speed">
      <label for="audio-speed">Tempo:</label>
      <select id="audio-speed" data-audio-speed>
        <option value="0.75">0.75×</option>
        <option value="1" selected>1×</option>
        <option value="1.25">1.25×</option>
        <option value="1.5">1.5×</option>
      </select>
    </div>
  </div>

  <audio controls preload="metadata" src={src} data-audio>
    Twoja przeglądarka nie wspiera elementu audio.
    <a href={src}>Pobierz nagranie MP3</a>.
  </audio>

  <div class="audio-player__hint">
    <strong>Wskazówka:</strong> nagrania CKE odtwarzane są <strong>dwukrotnie</strong> — możesz przewinąć i posłuchać ponownie. Skróty: <kbd>spacja</kbd> pauza, strzałki ←/→ przewijanie 5s.
  </div>

  {transcript && (
    <details class="audio-player__transcript">
      <summary>Pokaż transkrypcję nagrania</summary>
      <div class="audio-player__transcript-body" set:html={transcript}></div>
    </details>
  )}
</div>

<style>
  .audio-player {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0 2rem;
  }

  .audio-player__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .audio-player__title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .audio-player__title svg {
    color: var(--color-accent);
  }

  .audio-player__speed {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }

  .audio-player__speed select {
    background: var(--color-bg);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
    cursor: pointer;
  }

  audio {
    width: 100%;
    height: 40px;
    display: block;
  }

  .audio-player__hint {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    margin-top: 0.75rem;
    line-height: 1.5;
  }

  .audio-player__hint kbd {
    display: inline-block;
    padding: 0.0625rem 0.375rem;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
  }

  .audio-player__transcript {
    margin-top: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .audio-player__transcript summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    user-select: none;
  }

  .audio-player__transcript summary:hover {
    color: var(--color-accent-hover, var(--color-accent));
  }

  .audio-player__transcript-body {
    margin-top: 0.75rem;
    padding: 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .audio-player__transcript-body :global(p) {
    margin: 0 0 0.75rem;
  }

  .audio-player__transcript-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .audio-player__transcript-body :global(strong) {
    color: var(--color-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-audio-player]').forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>('[data-audio]');
    const speed = root.querySelector<HTMLSelectElement>('[data-audio-speed]');
    if (!audio || !speed) return;
    speed.addEventListener('change', () => {
      audio.playbackRate = parseFloat(speed.value);
    });
  });
</script>
