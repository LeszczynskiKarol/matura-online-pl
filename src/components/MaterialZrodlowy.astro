---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  zrodlo?: string;
  pdfUrl?: string;
  pdfPage?: number;
  zoom?: boolean;
}

const {
  src,
  alt,
  caption,
  zrodlo,
  pdfUrl,
  pdfPage,
  zoom = true,
} = Astro.props;
---

<figure class="material-zrodlowy">
  <div class={`material-zrodlowy__frame${zoom ? ' is-zoomable' : ''}`}>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
    {zoom && (
      <button
        type="button"
        class="material-zrodlowy__zoom"
        data-zoom-trigger
        data-zoom-src={src}
        data-zoom-alt={alt}
        aria-label="Powiększ materiał źródłowy"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        Powiększ
      </button>
    )}
  </div>
  {(caption || zrodlo || pdfUrl) && (
    <figcaption class="material-zrodlowy__caption">
      {caption && <span class="material-zrodlowy__text">{caption}</span>}
      {(zrodlo || pdfUrl) && (
        <span class="material-zrodlowy__source">
          {zrodlo && <span>Na podstawie: {zrodlo}</span>}
          {pdfUrl && (
            <a href={pdfUrl} target="_blank" rel="noopener">
              {pdfPage ? `Oryginalny PDF CKE, str. ${pdfPage}` : "Oryginalny PDF CKE"}
            </a>
          )}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  .material-zrodlowy {
    margin: 1.5rem 0;
  }

  .material-zrodlowy__frame {
    position: relative;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .material-zrodlowy__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .material-zrodlowy__zoom {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    background: rgba(0, 0, 0, 0.65);
    color: white;
    border: none;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    backdrop-filter: blur(4px);
  }

  .material-zrodlowy__zoom:hover {
    background: rgba(0, 0, 0, 0.85);
  }

  .material-zrodlowy__caption {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }

  .material-zrodlowy__text {
    font-style: italic;
  }

  .material-zrodlowy__source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .material-zrodlowy__source a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .material-zrodlowy__source a:hover {
    text-decoration: underline;
  }
</style>

<script>
  function ensureLightbox() {
    if (document.getElementById('material-lightbox')) return;
    const overlay = document.createElement('div');
    overlay.id = 'material-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.style.cssText = `
      position: fixed; inset: 0; background: rgba(0,0,0,0.85);
      display: none; align-items: center; justify-content: center;
      z-index: 9999; cursor: zoom-out; padding: 2rem;
    `;
    overlay.innerHTML = `
      <img id="material-lightbox-img" style="max-width:100%; max-height:100%; box-shadow: 0 20px 60px rgba(0,0,0,0.5);" alt="" />
      <button id="material-lightbox-close" aria-label="Zamknij" style="position:absolute; top:1rem; right:1rem; background:white; border:none; width:40px; height:40px; border-radius:9999px; font-size:1.5rem; cursor:pointer;">×</button>
    `;
    document.body.appendChild(overlay);

    const close = () => {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    };
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    document.getElementById('material-lightbox-close')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.style.display === 'flex') close();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-zoom-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      ensureLightbox();
      const overlay = document.getElementById('material-lightbox')!;
      const img = document.getElementById('material-lightbox-img') as HTMLImageElement;
      img.src = btn.dataset.zoomSrc || '';
      img.alt = btn.dataset.zoomAlt || '';
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    });
  });
</script>
