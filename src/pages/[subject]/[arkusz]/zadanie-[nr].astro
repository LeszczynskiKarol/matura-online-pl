---
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import AudioPlayer from "../../../components/AudioPlayer.astro";
import { siteConfig } from "../../../config/site";
import { renderInlineMath, renderRichText } from "../../../lib/render-math";

export async function getStaticPaths() {
  const zadania = await getCollection("zadania");
  const arkusze = await getCollection("arkusze");
  const subjects = await getCollection("subjects");

  return zadania.map((z) => {
    const arkusz = arkusze.find((a) => a.id === z.data.arkusz.id)!;
    const subject = subjects.find((s) => s.id === z.data.subject.id)!;
    const arkuszSlug = arkusz.id.replace(`${subject.data.slug}-`, "");
    return {
      params: {
        subject: subject.data.slug,
        arkusz: arkuszSlug,
        nr: z.data.nr.toString(),
      },
      props: { zadanie: z, arkusz, subject },
    };
  });
}

const { zadanie, arkusz, subject } = Astro.props;
const { Content } = await render(zadanie);

const allZadania = await getCollection("zadania");
const allArkusze = await getCollection("arkusze");
const allSubjects = await getCollection("subjects");
const podobne = (zadanie.data.podobne || [])
  .map((slug) => allZadania.find((z) => z.id === slug))
  .filter((z): z is NonNullable<typeof z> => Boolean(z));

const poziomLabel = arkusz.data.poziom === "pp" ? "podstawowy" : "rozszerzony";
const arkuszSlug = arkusz.id.replace(`${subject.data.slug}-`, "");
const url = `${siteConfig.url}/${subject.data.slug}/${arkuszSlug}/zadanie-${zadanie.data.nr}/`;

const title = `Zadanie ${zadanie.data.nr} — rozwiązanie, matura ${subject.data.nameDopelniacz} ${arkusz.data.sesja} ${arkusz.data.rok}, ${arkusz.data.poziom.toUpperCase()}`;
const description = `Rozwiązanie krok po kroku zadania ${zadanie.data.nr} z arkusza CKE matury z ${subject.data.nameDopelniacz}, ${arkusz.data.sesja} ${arkusz.data.rok}, poziom ${poziomLabel}. ${zadanie.data.tresc}`;
const trescHtml = renderRichText(zadanie.data.tresc);

// Sąsiednie zadania (poprzednie/następne w arkuszu)
const arkuszZadania = allZadania
  .filter((z) => z.data.arkusz.id === arkusz.id)
  .sort((a, b) => a.data.nr - b.data.nr);
const currentIdx = arkuszZadania.findIndex((z) => z.id === zadanie.id);
const prevZadanie = arkuszZadania[currentIdx - 1] ?? null;
const nextZadanie = arkuszZadania[currentIdx + 1] ?? null;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: siteConfig.url },
      {
        "@type": "ListItem",
        position: 2,
        name: subject.data.name,
        item: `${siteConfig.url}/${subject.data.slug}/`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: `${arkusz.data.sesja} ${arkusz.data.rok}, ${poziomLabel}`,
        item: `${siteConfig.url}/${subject.data.slug}/${arkuszSlug}/`,
      },
      {
        "@type": "ListItem",
        position: 4,
        name: `Zadanie ${zadanie.data.nr}`,
        item: url,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    "@id": url,
    name: `Zadanie ${zadanie.data.nr} — matura ${subject.data.nameDopelniacz}, ${arkusz.data.sesja} ${arkusz.data.rok}`,
    description: zadanie.data.tresc,
    inLanguage: "pl-PL",
    educationalLevel: poziomLabel === "podstawowy" ? "BasicLevel" : "AdvancedLevel",
    teaches: zadanie.data.topic,
    learningResourceType: "Exercise",
    educationalUse: "exam preparation",
    isPartOf: {
      "@type": "LearningResource",
      name: `Matura ${subject.data.nameDopelniacz}, ${arkusz.data.sesja} ${arkusz.data.rok}, poziom ${poziomLabel}`,
      url: `${siteConfig.url}/${subject.data.slug}/${arkuszSlug}/`,
    },
    about: {
      "@type": "Thing",
      name: subject.data.name,
    },
  },
];

const typLabels: Record<string, string> = {
  "zamkniete-abcd": "Zamknięte (ABCD)",
  "zamkniete-pf": "Zamknięte (Prawda/Fałsz)",
  "zamkniete-dobierz": "Zamknięte (na dobieranie)",
  "otwarte-krotkie": "Otwarte krótkie",
  "otwarte-rozszerzone": "Otwarte rozszerzone",
  "dowod": "Dowód",
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={url}
  jsonLd={jsonLd}
>
  <SiteHeader />

  <main id="main">
    <nav aria-label="Breadcrumb" class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-3xl px-4 py-3 text-sm sm:px-6 lg:px-8">
        <ol class="flex flex-wrap items-center gap-2 text-[var(--color-text-muted)]">
          <li><a href="/" class="no-underline hover:text-[var(--color-text)]">Strona główna</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/${subject.data.slug}/`} class="no-underline hover:text-[var(--color-text)]">
              {subject.data.name}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a
              href={`/${subject.data.slug}/${arkuszSlug}/`}
              class="no-underline hover:text-[var(--color-text)]"
            >
              {arkusz.data.sesja} {arkusz.data.rok}, {arkusz.data.poziom.toUpperCase()}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-[var(--color-text)]" aria-current="page">
            Zadanie {zadanie.data.nr}
          </li>
        </ol>
      </div>
    </nav>

    <article>
      {/* Header zadania */}
      <header class="border-b border-[var(--color-border)]">
        <div class="mx-auto max-w-3xl px-4 pt-20 pb-12 sm:px-6 sm:pt-24 lg:px-8">
          <div class="flex flex-wrap items-center gap-2 text-xs font-mono uppercase tracking-wide">
            <span class="text-[var(--color-text-muted)]">
              {arkusz.data.symbol}
            </span>
            <span class="text-[var(--color-text-faint)]">•</span>
            <span class="text-[var(--color-accent)]">
              {typLabels[zadanie.data.typ] ?? zadanie.data.typ}
            </span>
            <span class="text-[var(--color-text-faint)]">•</span>
            <span class="text-[var(--color-text-muted)]">
              {zadanie.data.punkty} {zadanie.data.punkty === 1 ? "pkt" : "pkt"}
            </span>
            <span class="text-[var(--color-text-faint)]">•</span>
            <span class="text-[var(--color-text-muted)]">
              Trudność: {"★".repeat(zadanie.data.difficulty)}{"☆".repeat(5 - zadanie.data.difficulty)}
            </span>
          </div>

          <h1 class="mt-4 font-serif text-[length:var(--text-fs-h1)] font-medium leading-tight tracking-tight">
            Zadanie {zadanie.data.nr}
          </h1>
          <p class="mt-2 text-lg text-[var(--color-text-muted)]">
            Matura z {subject.data.nameDopelniacz}, {arkusz.data.sesja} {arkusz.data.rok}, poziom {poziomLabel}
          </p>

          {zadanie.data.wymaganie && (
            <p class="mt-6 text-sm text-[var(--color-text-muted)]">
              <span class="font-mono uppercase tracking-wide text-[var(--color-text-faint)]">Wymaganie: </span>
              <span set:html={renderRichText(zadanie.data.wymaganie)} />
            </p>
          )}
        </div>
      </header>

      {/* Treść zadania */}
      <section class="border-b border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
        <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-text-muted)]">
            Treść zadania
          </h2>
          <div
            class="tresc-zadania mt-3 text-[1.0625rem] leading-relaxed"
            set:html={trescHtml}
          />
          {zadanie.data.hasAudio && (zadanie.data.audioUrl || arkusz.data.audioUrl) && (
            <AudioPlayer
              src={zadanie.data.audioUrl ?? arkusz.data.audioUrl!}
              title={`Nagranie do zadania ${zadanie.data.nr} (CKE)`}
            />
          )}
          {arkusz.data.pdfArkuszUrl && (
            <p class="mt-3 text-xs text-[var(--color-text-faint)]">
              Źródło: arkusz CKE {arkusz.data.symbol}.
              {" "}
              <a
                href={arkusz.data.pdfArkuszUrl}
                target="_blank"
                rel="noopener"
                class="underline decoration-1 underline-offset-2 hover:text-[var(--color-accent)]"
              >
                Otwórz oryginalny PDF
              </a>
            </p>
          )}
        </div>
      </section>

      {/* Rozwiązanie */}
      <section data-prose>
        <div class="prose mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
          <Content />
        </div>
      </section>

      {/* Nawigacja prev/next */}
      <nav aria-label="Inne zadania w arkuszu" class="border-t border-[var(--color-border)]">
        <div class="mx-auto grid max-w-3xl gap-4 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:px-8">
          {prevZadanie ? (
            <a
              href={`/${subject.data.slug}/${arkuszSlug}/zadanie-${prevZadanie.data.nr}/`}
              class="group flex items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-4 no-underline transition-colors hover:border-[var(--color-accent)]"
            >
              <Icon name="lucide:arrow-left" class="h-5 w-5 flex-shrink-0 text-[var(--color-text-faint)] group-hover:text-[var(--color-accent)]" />
              <div class="min-w-0">
                <p class="text-xs font-mono uppercase tracking-wide text-[var(--color-text-faint)]">
                  Poprzednie
                </p>
                <p class="mt-0.5 text-sm font-medium text-[var(--color-text)]">
                  Zadanie {prevZadanie.data.nr} — {prevZadanie.data.topic}
                </p>
              </div>
            </a>
          ) : (
            <div></div>
          )}
          {nextZadanie ? (
            <a
              href={`/${subject.data.slug}/${arkuszSlug}/zadanie-${nextZadanie.data.nr}/`}
              class="group flex items-center justify-end gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-4 text-right no-underline transition-colors hover:border-[var(--color-accent)]"
            >
              <div class="min-w-0">
                <p class="text-xs font-mono uppercase tracking-wide text-[var(--color-text-faint)]">
                  Następne
                </p>
                <p class="mt-0.5 text-sm font-medium text-[var(--color-text)]">
                  Zadanie {nextZadanie.data.nr} — {nextZadanie.data.topic}
                </p>
              </div>
              <Icon name="lucide:arrow-right" class="h-5 w-5 flex-shrink-0 text-[var(--color-text-faint)] group-hover:text-[var(--color-accent)]" />
            </a>
          ) : (
            <a
              href={`/${subject.data.slug}/${arkuszSlug}/`}
              class="group flex items-center justify-end gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-4 text-right no-underline transition-colors hover:border-[var(--color-accent)]"
            >
              <div class="min-w-0">
                <p class="text-xs font-mono uppercase tracking-wide text-[var(--color-text-faint)]">
                  Wróć do arkusza
                </p>
                <p class="mt-0.5 text-sm font-medium text-[var(--color-text)]">
                  Lista wszystkich zadań
                </p>
              </div>
              <Icon name="lucide:list" class="h-5 w-5 flex-shrink-0 text-[var(--color-text-faint)] group-hover:text-[var(--color-accent)]" />
            </a>
          )}
        </div>
      </nav>

      {/* Podobne zadania */}
      {podobne.length > 0 && (
        <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
          <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
            <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-text-muted)]">
              Podobne zadania
            </h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {podobne.map((p) => {
                const pArkusz = allArkusze.find((a) => a.id === p.data.arkusz.id);
                const pSubject = allSubjects.find((s) => s.id === p.data.subject.id);
                if (!pArkusz || !pSubject) return null;
                const pSlug = pArkusz.id.replace(`${pSubject.data.slug}-`, "");
                const pPoziom = pArkusz.data.poziom.toUpperCase();
                const sameArkusz = pArkusz.id === arkusz.id;
                return (
                  <a
                    href={`/${pSubject.data.slug}/${pSlug}/zadanie-${p.data.nr}/`}
                    class="card no-underline"
                  >
                    <p class="text-xs font-mono uppercase tracking-wide text-[var(--color-accent)]">
                      {p.data.topic}
                    </p>
                    <p class="mt-2 font-medium text-[var(--color-text)]">
                      Zadanie {p.data.nr} ({p.data.punkty} pkt)
                    </p>
                    {!sameArkusz && (
                      <p class="mt-1 text-xs font-mono uppercase tracking-wide text-[var(--color-text-faint)]">
                        {pArkusz.data.sesja} {pArkusz.data.rok} • {pPoziom}
                      </p>
                    )}
                    <p class="mt-1 line-clamp-2 text-sm text-[var(--color-text-muted)]">
                      {p.data.tresc}
                    </p>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* CTA apka */}
      <section class="border-t border-[var(--color-border)]">
        <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6 lg:px-8">
          <p class="font-mono text-xs uppercase tracking-[0.1em] text-[var(--color-accent)]">
            Rozumiesz, jak to rozwiązać?
          </p>
          <h2 class="mt-3 font-serif text-2xl font-medium tracking-tight">
            Przećwicz podobne typy zadań w aplikacji
          </h2>
          <p class="mx-auto mt-3 max-w-[55ch] text-[var(--color-text-muted)]">
            {siteConfig.apka.name} ma tysiące zadań pogrupowanych po dziedzinach. Sprawdź, czy temat „{zadanie.data.topic}" zrobisz samodzielnie.
          </p>
          <a
            href={siteConfig.apka.url}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-md bg-[var(--color-accent-2)] px-5 py-2.5 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90"
          >
            Otwórz {siteConfig.apka.name}
            <Icon name="lucide:external-link" class="h-4 w-4" />
          </a>
        </div>
      </section>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
