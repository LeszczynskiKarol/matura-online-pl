---
import { Icon } from "astro-icon/components";
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import IconBadge from "../../components/IconBadge.astro";
import { siteConfig } from "../../config/site";

export async function getStaticPaths() {
  const subjects = await getCollection("subjects");
  return subjects.map((s) => ({
    params: { subject: s.data.slug },
    props: { subject: s },
  }));
}

const { subject } = Astro.props;
const arkusze = (await getCollection("arkusze")).filter(
  (a) => a.data.subject.id === subject.id
);

// Sortowanie arkuszy: nowsze rok i poziom PR przed PP
const sortedArkusze = arkusze.sort((a, b) => {
  if (a.data.rok !== b.data.rok) return b.data.rok - a.data.rok;
  if (a.data.poziom !== b.data.poziom) return a.data.poziom === "pr" ? -1 : 1;
  return 0;
});

const allZadania = await getCollection("zadania");

const title = `Matura ${subject.data.nameDopelniacz} — rozwiązania zadań CKE`;
const description = `Pełne rozwiązania zadań z matury z ${subject.data.nameDopelniacz}, krok po kroku. ${subject.data.description}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Strona główna", item: siteConfig.url },
      {
        "@type": "ListItem",
        position: 2,
        name: subject.data.name,
        item: `${siteConfig.url}/${subject.data.slug}/`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description: description,
    inLanguage: "pl-PL",
    hasPart: sortedArkusze.map((a) => {
      const arkuszSlug = a.id.replace(`${subject.data.slug}-`, "");
      return {
        "@type": "LearningResource",
        name: `Matura ${subject.data.nameDopelniacz}, ${a.data.sesja} ${a.data.rok}, poziom ${a.data.poziom === "pp" ? "podstawowy" : "rozszerzony"}`,
        url: `${siteConfig.url}/${subject.data.slug}/${arkuszSlug}/`,
      };
    }),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  noindex={!subject.data.hasContent}
>
  <SiteHeader />

  <main id="main">
    <nav aria-label="Breadcrumb" class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-4xl px-4 py-3 text-sm sm:px-6 lg:px-8">
        <ol class="flex flex-wrap items-center gap-2 text-[var(--color-text-muted)]">
          <li><a href="/" class="no-underline hover:text-[var(--color-text)]">Strona główna</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-[var(--color-text)]" aria-current="page">{subject.data.name}</li>
        </ol>
      </div>
    </nav>

    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="flex items-start gap-4">
          <span class="inline-flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-xl bg-[var(--color-accent-soft)] text-[var(--color-accent)]">
            <Icon name={subject.data.icon} class="h-7 w-7" />
          </span>
          <div>
            <p class="text-sm font-mono uppercase tracking-wide text-[var(--color-text-muted)]">
              Przedmiot maturalny
            </p>
            <h1 class="mt-1 font-serif text-[length:var(--text-fs-h1)] font-medium leading-tight tracking-tight">
              Matura z {subject.data.nameDopelniacz}
            </h1>
          </div>
        </div>

        {subject.data.longDescription && (
          <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-[var(--color-text-muted)]">
            {subject.data.longDescription}
          </p>
        )}
      </div>
    </section>

    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
        <IconBadge icon="lucide:file-text" label="Arkusze CKE" tone="accent" />
        <h2 class="mt-4 font-serif text-[length:var(--text-fs-h2)] font-medium leading-tight tracking-tight">
          Wybierz arkusz
        </h2>

        {sortedArkusze.length === 0 ? (
          <div class="mt-12 rounded-xl border border-dashed border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-8 text-center">
            <Icon name="lucide:hourglass" class="mx-auto h-8 w-8 text-[var(--color-text-faint)]" />
            <p class="mt-4 text-[var(--color-text-muted)]">
              Arkusze z {subject.data.nameDopelniacz} dodajemy w kolejności priorytetu. Zacznij od dostępnych przedmiotów na <a href="/">stronie głównej</a>.
            </p>
          </div>
        ) : (
          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {sortedArkusze.map((a) => {
              const arkuszSlug = a.id.replace(`${subject.data.slug}-`, "");
              const zadaniaArkusza = allZadania.filter(
                (z) => z.data.arkusz.id === a.id
              );
              const poziomLabel = a.data.poziom === "pp" ? "Poziom podstawowy" : "Poziom rozszerzony";
              return (
                <a
                  href={`/${subject.data.slug}/${arkuszSlug}/`}
                  class="card group flex flex-col gap-3 no-underline"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono uppercase tracking-wide text-[var(--color-text-muted)]">
                      {a.data.symbol}
                    </span>
                    <span class="text-xs font-mono uppercase tracking-wide text-[var(--color-accent)]">
                      {poziomLabel}
                    </span>
                  </div>
                  <h3 class="font-serif text-xl font-medium leading-snug text-[var(--color-text)]">
                    Matura {subject.data.nameDopelniacz}, {a.data.sesja} {a.data.rok}
                  </h3>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--color-text-muted)]">
                    <span class="inline-flex items-center gap-1.5">
                      <Icon name="lucide:list" class="h-3.5 w-3.5" />
                      {a.data.liczbaZadan} zadań ({zadaniaArkusza.length} z rozwiązaniem)
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <Icon name="lucide:target" class="h-3.5 w-3.5" />
                      {a.data.liczbaPunktow} pkt
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <Icon name="lucide:clock" class="h-3.5 w-3.5" />
                      {a.data.czasMinut} min
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
